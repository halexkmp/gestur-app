{
  "CreateEmployeeRequest": {
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 255,
        "title": "Name"
      },
      "pix_key": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 255
          },
          {
            "type": "null"
          }
        ],
        "title": "Pix Key"
      },
      "salary": {
        "type": "number",
        "minimum": 0.0,
        "title": "Salary"
      },
      "active": {
        "type": "boolean",
        "title": "Active",
        "default": true
      }
    },
    "type": "object",
    "required": [
      "name",
      "salary"
    ],
    "title": "CreateEmployeeRequest"
  },
  "CreateSalaryAdvanceRequest": {
    "properties": {
      "employee_id": {
        "type": "string",
        "format": "uuid",
        "title": "Employee Id"
      },
      "amount": {
        "anyOf": [
          {
            "type": "number",
            "exclusiveMinimum": 0.0
          },
          {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
          }
        ],
        "title": "Amount"
      },
      "note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Note"
      }
    },
    "type": "object",
    "required": [
      "employee_id",
      "amount"
    ],
    "title": "CreateSalaryAdvanceRequest"
  },
